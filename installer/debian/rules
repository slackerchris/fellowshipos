#!/usr/bin/make -f
export GOCACHE := $(CURDIR)/debian/.gocache
export GOFLAGS := -buildvcs=false -trimpath
export GOTOOLCHAIN := local

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	go build -o debian/bin/ ./cmd/fellowship-installer

override_dh_auto_test:
	go test ./...

override_dh_auto_install:

override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_installsystemd:
	dh_installsystemd --name=fellowship-installer
	dh_installsystemd --name=fellowship-installer-kiosk

override_dh_auto_clean:
	rm -rf debian/bin debian/.gocache
