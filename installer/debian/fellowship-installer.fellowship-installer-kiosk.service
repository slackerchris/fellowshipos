[Unit]
Description=FellowshipOS installer on this screen
# The same rule as the installer itself: any graphical install entry
ConditionKernelCommandLine=fellowship.installer
After=fellowship-installer.service systemd-user-sessions.service
Wants=fellowship-installer.service
# The installer takes the first screen instead of a login prompt
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=fellowship-kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Environment=XDG_SESSION_TYPE=wayland
# Drawn on the CPU with pixman rather than OpenGL. Without a graphics card, as
# in most VMs, OpenGL is Mesa's software renderer, and on a virtual display
# the compositor showed its frames before they were finished: half-drawn pages with
# black streaks whenever something changed. Pixman finishes each frame before
# it is shown, and an installer page needs nothing faster.
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
# Sway with a kiosk config, not cage: cage leaves touchpad tapping off
# (DESK-001; see kiosk.sway).
ExecStart=/usr/bin/sway --unsupported-gpu -c /usr/lib/fellowship-installer/kiosk.sway
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target multi-user.target
