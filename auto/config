#!/bin/bash
# live-build configuration, run by `lb config`. FELLOWSHIP_EDITION chooses which
# of the two images this build is: the ISO's name, the boot menu entry and the
# value the installer reads from the kernel command line all follow from it.
set -e

EDITION="${FELLOWSHIP_EDITION:-multi}"
case "$EDITION" in
    nas)
        TITLE="FellowshipOS NAS"
        VOLUME="FELLOWSHIPOS_NAS"
        ENTRY="Install FellowshipOS NAS (graphical)"
        HOTKEY="n"
        ;;
    multi)
        TITLE="FellowshipOS Multi-purpose"
        VOLUME="FELLOWSHIPOS_MULTI"
        ENTRY="Install FellowshipOS Multi-purpose (graphical)"
        HOTKEY="m"
        ;;
    *)
        echo "auto/config: no such edition: $EDITION" >&2
        exit 1
        ;;
esac

lb config noauto \
    --architecture amd64 \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap http://deb.debian.org/debian/ \
    --mirror-chroot http://deb.debian.org/debian/ \
    --mirror-chroot-security http://security.debian.org/debian-security/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --mirror-binary-security http://security.debian.org/debian-security/ \
    --linux-packages "linux-image" \
    --linux-flavours "amd64" \
    --firmware-chroot false \
    --firmware-binary false \
    --debian-installer live \
    --debian-installer-gui false \
    --bootappend-install "file=/cdrom/install/preseed.cfg" \
    --binary-images iso-hybrid \
    --bootloader "grub-efi" \
    --memtest none \
    --win32-loader false \
    --apt-recommends false \
    --iso-volume "$VOLUME" \
    --iso-publisher "Chris" \
    --iso-application "$TITLE"

# The boot menu belongs to the image being built: its first entry is the one
# that starts the graphical installer, and it says which image this is.
sed -e "s|@ENTRY@|$ENTRY|g" -e "s|@EDITION@|$EDITION|g" -e "s|@HOTKEY@|$HOTKEY|g" \
    config/bootloaders/grub-pc/grub.cfg.in > config/bootloaders/grub-pc/grub.cfg
