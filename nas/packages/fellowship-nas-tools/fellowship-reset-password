#!/usr/bin/python3
"""fellowship-reset-password: root sets a NAS person's password at the console.

The desktop's own change asks for the password in use now; this is the way back
when it is lost, or when the person is locked out of the desktop. One password
for the desktop and every way to share, set together, and every session the old
one opened ends. The work is in fellowship_nas.users."""
import getpass
import os
import sys

from fellowship_nas import users
from fellowship_nas.common import FnasError


def ask_name():
    people = [user["name"] for user in users.list_users()]
    if not people:
        raise FnasError("this NAS has no people yet: make one in the desktop's Users")
    print("People on this NAS: " + ", ".join(people))
    name = input("Whose password? ").strip()
    if not name:
        raise FnasError("no name given")
    return name


def ask_password(name):
    first = getpass.getpass(f"New password for {name}: ")
    again = getpass.getpass("Again: ")
    if first != again:
        raise FnasError("the passwords don't match")
    users.check_password(first)
    return first


def main():
    try:
        if os.geteuid() != 0:
            raise FnasError("run as root, at the console")
        name = sys.argv[1] if len(sys.argv) > 1 else ask_name()
        users.find_user(name)
        users.set_password(name, ask_password(name))
        print(f"{name}'s password is set, for the desktop and every way to share.")
        print("Every session the old password opened is ended.")
    except FnasError as error:
        print(f"fellowship-reset-password: {error}", file=sys.stderr)
        return 1
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
