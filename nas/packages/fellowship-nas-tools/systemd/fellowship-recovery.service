[Unit]
Description=FellowshipOS recovery on the console
DefaultDependencies=no
After=sysinit.target plymouth-start.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=idle
ExecStartPre=-/usr/bin/plymouth --wait quit
ExecStart=/usr/lib/fellowship-nas/fellowship-nas-recovery
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=process
