#!/usr/bin/python3
"""fellowship-root-ssh: root's own switch for SSH on a separated NAS. Keys
only, off by default, and only root can turn it on -- the desktop can read the
state in Settings but never change it. The work is in fellowship_nas.ssh."""
import os
import sys

from fellowship_nas import ssh
from fellowship_nas.common import FnasError


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action not in ("on", "off", "status"):
        print("usage: fellowship-root-ssh on|off|status", file=sys.stderr)
        return 1
    try:
        if os.geteuid() != 0:
            raise FnasError("run as root, at the console")
        if action == "status":
            print("Root SSH is " + ("on, keys only" if ssh.root_ssh() else "off: root logs in at the console"))
        else:
            ssh.set_root_ssh(action == "on")
            print("Root SSH is " + ("on, keys only" if action == "on" else "off: root logs in at the console"))
    except FnasError as error:
        print(f"fellowship-root-ssh: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
