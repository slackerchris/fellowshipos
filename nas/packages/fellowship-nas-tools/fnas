class FnasError(Exception):
    pass


def run(*command, check=True, stdin=None):
    try:
        result = subprocess.run(command, input=stdin, capture_output=True, text=True,
                                env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C", "HOME": "/root"})
    except FileNotFoundError:
        raise FnasError(f"{command[0]} is not installed") from None
    if check and result.returncode != 0:
        raise FnasError(result.stderr.strip() or f"{command[0]} failed")
    return result


def human_size(size):
    value = float(size)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1000:
            return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1000
    return f"{value:.1f} PB"


def by_id_links():
    """Map each whole-disk device to its preferred /dev/disk/by-id path."""
    links = {}
    if not os.path.isdir(BY_ID_DIR):
        return links
    for name in sorted(os.listdir(BY_ID_DIR)):
        if "-part" in name or not name.startswith(BY_ID_PREFERENCE):
            continue
        rank = next(i for i, p in enumerate(BY_ID_PREFERENCE) if name.startswith(p))
        path = os.path.join(BY_ID_DIR, name)
        device = os.path.realpath(path)
        if device not in links or rank < links[device][0]:
            links[device] = (rank, path)
    return {device: path for device, (_, path) in links.items()}


def imported_pool_devices():
    """Map each device in an imported pool to its pool's name."""
    devices = {}
    pool = None
    for line in run("zpool", "list", "-vHPL").stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        if not line[0].isspace():
            pool = fields[0]
        elif fields[0].startswith("/dev/"):
            devices[fields[0]] = pool
    return devices


def walk(device):
    yield device
    for child in device.get("children", []):
        yield from walk(child)


def classify(device, pool_devices):
    """Return a disk's state: os, in-use, has-data or empty, plus the reason."""
    tree = list(walk(device))
    mounts = {m for d in tree for m in d.get("mountpoints") or [] if m}
    if mounts & OS_MOUNTS:
        return "os", "holds the operating system"
    for d in tree:
        if d["path"] in pool_devices:
            return "in-use", f"in pool {pool_devices[d['path']]}"
    if mounts:
        return "in-use", "mounted at " + ", ".join(sorted(mounts))
    fstypes = sorted({d["fstype"] for d in tree if d.get("fstype")})
    if "zfs_member" in fstypes:
        return "has-data", "has a ZFS label"
    if fstypes:
        return "has-data", "has a filesystem: " + ", ".join(fstypes)
    if len(tree) > 1:
        return "has-data", "has partitions"
    return "empty", ""


def list_disks():
    output = run("lsblk", "-J", "-b", "-o",
                 "NAME,PATH,TYPE,SIZE,MODEL,SERIAL,FSTYPE,MOUNTPOINTS").stdout
    links = by_id_links()
    pool_devices = imported_pool_devices()
    disks = []
    for device in json.loads(output)["blockdevices"]:
        # zd is a ZFS volume, fd a floppy drive, and an empty card reader has size 0
        if device["type"] != "disk" or device["name"].startswith(("zd", "fd")) or not device["size"]:
            continue
        state, reason = classify(device, pool_devices)
        disks.append({
            "path": device["path"],
            "by_id": links.get(device["path"]),
            "size": device["size"],
            "model": (device.get("model") or "").strip(),
            "serial": (device.get("serial") or "").strip(),
            "state": state,
            "reason": reason,
            "partitions": [d["path"] for d in walk(device)][1:],
        })
    return disks


def scan_pools():
    """Return pools that could be imported, with what ZFS says about each."""
    result = run("zpool", "import", "-d", BY_ID_DIR, check=False)
    pools = []
    key = None
    for line in result.stdout.splitlines():
        match = re.match(r"^\s*(pool|id|state|status|action|comment): ?(.*)$", line)
        if match:
            key = match.group(1)
            if key == "pool":
                pools.append({})
            if pools:
                pools[-1][key] = match.group(2).strip()
        elif re.match(r"^\s*(config|see):", line):
            key = None
        elif key and pools and line.strip():
            pools[-1][key] = f"{pools[-1].get(key, '')} {line.strip()}".strip()
    if result.returncode != 0 and not pools and "no pools available" not in result.stderr:
        raise FnasError(result.stderr.strip() or "zpool import failed")
    return pools


def list_pools():
    fields = ("name", "size", "allocated", "free", "health", "readonly")
    output = run("zpool", "list", "-Hp", "-o", ",".join(fields)).stdout
    pools = [dict(zip(fields, line.split("\t"))) for line in output.splitlines()]
    for pool in pools:
        for key in ("size", "allocated", "free"):
            pool[key] = int(pool[key])
    return pools


def check_pool_name(name):
    if not POOL_NAME.match(name):
        raise FnasError("pool names use lowercase letters, numbers, - and _, "
                        "start with a letter, and are at most 32 characters")
    if name.startswith(RESERVED_POOL_PREFIXES):
        raise FnasError(f"{name} starts with a word ZFS reserves")


def find_disk(disks, wanted):
    matches = [d for d in disks if wanted and wanted in (d["path"], d["by_id"], d["serial"])]
    if len(matches) != 1:
        raise FnasError(f"no such disk: {wanted}")
    return matches[0]


def vdev_args(layout, paths):
    minimum = LAYOUT_MIN_DISKS[layout]
    if len(paths) < minimum:
        raise FnasError(f"{layout} needs at least {minimum} disks")
    if layout == "single":
        if len(paths) != 1:
            raise FnasError("single takes exactly 1 disk")
        return paths
    if layout == "mirror":
        if len(paths) % 2:
            raise FnasError("mirror takes an even number of disks")
        args = []
        for i in range(0, len(paths), 2):
            args += ["mirror", paths[i], paths[i + 1]]
        return args
    return [layout] + paths


def confirmation_for(count):
    return f"erase {count} disk" + ("" if count == 1 else "s")


def wipe(disk):
    """Clear old signatures, so zpool create doesn't need -f."""
    for partition in disk["partitions"]:
        run("zpool", "labelclear", "-f", partition, check=False)
        run("wipefs", "-a", partition)
    run("wipefs", "-a", disk["path"])


def create_pool(name, layout, wanted, confirm, wipe_disks):
    check_pool_name(name)
    disks = list_disks()
    chosen = [find_disk(disks, w) for w in wanted]
    if len({d["path"] for d in chosen}) != len(chosen):
        raise FnasError("the same disk is listed twice")
    for disk in chosen:
        if disk["state"] in ("os", "in-use"):
            raise FnasError(f"{disk['path']} can't be used: {disk['reason']}")
        if disk["state"] == "has-data" and not wipe_disks:
            raise FnasError(f"{disk['path']} {disk['reason']}: check it, then pass --wipe to erase it")
        if not disk["by_id"]:
            raise FnasError(f"{disk['path']} has no stable name in {BY_ID_DIR}")
    vdevs = vdev_args(layout, [d["by_id"] for d in chosen])
    known = [p["name"] for p in list_pools()] + [p.get("pool") for p in scan_pools()]
    if name in known:
        raise FnasError(f"a pool named {name} already exists")
    expected = confirmation_for(len(chosen))
    if confirm != expected:
        raise FnasError(f'confirm by passing --confirm "{expected}"')

    if wipe_disks:
        for disk in chosen:
            wipe(disk)
    command = ["zpool", "create"]
    for prop in POOL_PROPERTIES:
        command += ["-o", prop]
    for prop in DATASET_PROPERTIES:
        command += ["-O", prop]
    run(*command, name, *vdevs)
    for dataset in DEFAULT_DATASETS:
        run("zfs", "create", f"{name}/{dataset}")


def import_pool(pool, readonly, force=False):
    found = [p for p in scan_pools() if pool in (p.get("pool"), p.get("id"))]
    if not found:
        raise FnasError(f"no importable pool: {pool}")
    status = found[0].get("status", "")
    command = ["zpool", "import", "-d", BY_ID_DIR]
    if "currently imported by another system" in status:
        # Multihost protection: another machine has it imported right now
        raise FnasError(f"{pool} is in use by another system; export it there first")
    if "last accessed by another system" in status:
        # Normal after a reinstall: the old system never exported it
        if not force:
            raise FnasError(f"{pool} was last used by another system (normal after a "
                            "reinstall): make sure that system is off, then pass --force")
        command.append("-f")
    if readonly:
        command += ["-o", "readonly=on"]
    run(*command, pool)
    write_smb_config()


def export_pool(name):
    if name not in [p["name"] for p in list_pools()]:
        raise FnasError(f"no imported pool: {name}")
    result = run("zpool", "export", name, check=False)
    if result.returncode != 0:
        # ZFS stops sharing before it finds out it can't unmount
        run("zfs", "share", "-a", check=False)
        raise FnasError(f"{result.stderr.strip()}: disconnect any clients and try again")
    write_smb_config()


def check_subnet(value):
    """Return a private IPv4 subnet in canonical form, so nothing is exported to the world."""
    try:
        subnet = ipaddress.IPv4Network(value, strict=False)
    except ValueError:
        raise FnasError(f"not a subnet: {value} (expected something like 192.168.1.0/24)") from None
    if not subnet.is_private or subnet.prefixlen < 8 or subnet.prefixlen > 30:
        raise FnasError(f"{subnet} isn't a private LAN subnet between /8 and /30")
    return str(subnet)


def lan_subnet():
    try:
        with open(LAN_FILE) as file:
            return check_subnet(file.read().strip())
    except FileNotFoundError:
        raise FnasError("no LAN subnet set: run fnas lan set 192.168.1.0/24") from None


def sharenfs_value(mode, subnet):
    options = f"rw=@{subnet}"
    if mode == "shared":
        return f"{options},all_squash,anonuid={SHARE_ID},anongid={SHARE_ID}"
    return f"{options},root_squash"


def list_shares():
    fields = ("name", "mountpoint", "sharenfs", MODE_PROPERTY, SMB_PROPERTY, POLICY_PROPERTY, "readonly")
    output = run("zfs", "list", "-H", "-t", "filesystem", "-o", ",".join(fields)).stdout
    shares = []
    for line in output.splitlines():
        dataset, path, sharenfs, mode, smb, policy, readonly = line.split("\t")
        match = SHARE_DATASET.match(dataset)
        if match and mode in SHARE_MODES:
            shares.append({"name": match.group(2), "pool": match.group(1), "dataset": dataset,
                           "path": path, "mode": mode, "nfs": sharenfs != "off", "smb": smb == "on",
                           "policy": parse_policy(policy), "readonly": readonly == "on"})
    return shares


def find_share(name):
    for share in list_shares():
        if share["name"] == name:
            return share
    raise FnasError(f"no such share: {name}")


def smb_share_config(share, subnet):
    lines = ["# Generated by fnas from ZFS properties: changes here are overwritten",
             f"[{share['name']}]",
             f"path = {share['path']}",
             "read only = no",
             f"hosts allow = {subnet} 127.0.0.1",
             "vfs objects = shadow_copy2",
             "shadow:snapdir = .zfs/snapshot",
             # Sanoid ends each name with its period. The prefix setting makes Samba
             # keep the real names, which it couldn't rebuild from the format alone.
             # Its service runs in UTC, so shadow:localtime must stay off.
             "shadow:snapprefix = ^autosnap$",
             "shadow:delimiter = _",
             "shadow:format = _%Y-%m-%d_%H:%M:%S",
             "shadow:sort = desc"]
    if share["mode"] == "shared":
        lines += [f"force user = {SHARE_ACCOUNT}",
                  f"force group = {SHARE_ACCOUNT}",
                  "create mask = 0664",
                  "directory mask = 2775"]
    return "\n".join(lines) + "\n"


def write_file(path, content, mode=0o644):
    descriptor = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(descriptor, "w") as file:
        os.fchmod(descriptor, mode)
        file.write(content)
    os.replace(path + ".new", path)


def read_json(path, default=None):
    try:
        with open(path) as file:
            return json.load(file)
    except FileNotFoundError:
        return default
    except ValueError:
        raise FnasError(f"{path} is damaged") from None


def write_json(path, data, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_file(path, json.dumps(data, indent=2) + "\n", mode)


@contextlib.contextmanager
def locked(path, wait=True):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise FnasError("another fnas is already doing this") from None
        yield


def write_smb_config():
    """Rebuild every share file and the master file from what ZFS says now."""
    if not os.path.isdir(SMB_DIR):
        return
    shares = [s for s in list_shares() if s["smb"]]
    directory = os.path.join(SMB_DIR, "shares")
    os.makedirs(directory, exist_ok=True)
    wanted = {s["name"] + ".conf" for s in shares}
    for name in set(os.listdir(directory)) - wanted:
        os.remove(os.path.join(directory, name))
    for share in shares:
        write_file(os.path.join(directory, share["name"] + ".conf"),
                   smb_share_config(share, lan_subnet()))
    write_file(os.path.join(SMB_DIR, "shares.conf"),
               "".join(f"include = {os.path.join(directory, name)}\n" for name in sorted(wanted)))
    run("smbcontrol", "smbd", "reload-config", check=False)


def create_share(name, pool, mode, owner, nfs, smb):
    if not SHARE_NAME.match(name) or name.lower() in RESERVED_SHARE_NAMES:
        raise FnasError("share names use letters, numbers, - and _, start with a letter "
                        "or number, and are at most 32 characters")
    if not nfs and not smb:
        raise FnasError("choose at least one of --nfs and --smb")
    if smb and not os.path.isdir(SMB_DIR):
        raise FnasError("SMB needs the fellowship-nas-smb package")
    if mode == "matched" and not owner:
        raise FnasError("matched shares need an --owner")
    if mode == "shared" and owner:
        raise FnasError(f"shared folders belong to {SHARE_ACCOUNT}, so --owner doesn't apply")
    if pool not in [p["name"] for p in list_pools()]:
        raise FnasError(f"no imported pool: {pool}")
    # Samba share names ignore case, so two shares can't differ only by it
    if name.lower() in [s["name"].lower() for s in list_shares()]:
        raise FnasError(f"a share named {name} already exists")
    uid, gid = SHARE_ID, SHARE_ID
    if owner:
        try:
            account = pwd.getpwnam(owner)
        except KeyError:
            raise FnasError(f"no such user: {owner}") from None
        uid, gid = account.pw_uid, account.pw_gid
    subnet = lan_subnet()

    dataset = f"{pool}/shares/{name}"
    if run("zfs", "list", "-H", "-o", "name", dataset, check=False).returncode == 0:
        raise FnasError(f"{dataset} already exists and isn't a share")
    run("zfs", "create", "-p", "-o", f"{MODE_PROPERTY}={mode}",
        "-o", f"{SMB_PROPERTY}={'on' if smb else 'off'}", dataset)
    path = run("zfs", "get", "-H", "-o", "value", "mountpoint", dataset).stdout.strip()
    os.chown(path, uid, gid)
    # chown clears the setgid bit, so the mode comes second
    os.chmod(path, 0o2775 if mode == "shared" else 0o2770)
    if nfs:
        run("zfs", "set", f"sharenfs={sharenfs_value(mode, subnet)}", dataset)
    write_smb_config()


def set_share(name, nfs, smb):
    if nfs is None and smb is None:
        raise FnasError("nothing to change: pass --nfs or --smb")
    share = find_share(name)
    if smb == "on" and not os.path.isdir(SMB_DIR):
        raise FnasError("SMB needs the fellowship-nas-smb package")
    if nfs is not None:
        value = sharenfs_value(share["mode"], lan_subnet()) if nfs == "on" else "off"
        run("zfs", "set", f"sharenfs={value}", share["dataset"])
    if smb is not None:
        run("zfs", "set", f"{SMB_PROPERTY}={smb}", share["dataset"])
        write_smb_config()


def delete_share(name, confirm):
    share = find_share(name)
    snapshots = run("zfs", "list", "-H", "-t", "snapshot", "-o", "name", "-r",
                    share["dataset"]).stdout.split()
    count = len(snapshots)
    expected = f"delete {name} and {count} snapshot" + ("" if count == 1 else "s")
    if confirm != expected:
        lost = "".join(f"\n    {snapshot}" for snapshot in snapshots)
        raise FnasError(f"this destroys all data in {share['dataset']}{lost}\n"
                        f'confirm by passing --confirm "{expected}"')
    run("zfs", "destroy", "-r", share["dataset"])
    write_smb_config()


def set_lan(value):
    subnet = check_subnet(value)
    os.makedirs(os.path.dirname(LAN_FILE), exist_ok=True)
    write_file(LAN_FILE, subnet + "\n")
    for share in list_shares():
        if share["nfs"]:
            run("zfs", "set", f"sharenfs={sharenfs_value(share['mode'], subnet)}", share["dataset"])
    write_smb_config()
    return subnet


def parse_policy(value):
    """Read "hourly,daily,monthly". Shares made before snapshots existed have none."""
    parts = value.split(",")
    if len(parts) == len(DEFAULT_POLICY) and all(part.isdigit() for part in parts):
        return dict(zip(DEFAULT_POLICY, map(int, parts)))
    return dict(DEFAULT_POLICY)


def writable_pools():
    return [p["name"] for p in list_pools() if p["readonly"] == "off"]


def backup_root(target):
    return f"{target}/{BACKUP_DATASET}"


def sanoid_config(shares, backup_dataset):
    lines = ["# Generated by fnas from ZFS properties: changes here are overwritten", "",
             "[template_fellowship]", "autosnap = yes", "autoprune = yes",
             "frequently = 0", "weekly = 0", "yearly = 0",
             # One run gives its snapshots the same time, and Windows would list each
             # as a separate version. Sanoid runs every 15 minutes, in UTC, so these
             # keep the periods on different runs.
             "hourly_min = 0", "daily_hour = 23", "daily_min = 30",
             "monthly_mday = 1", "monthly_hour = 0", "monthly_min = 15"]
    for share in shares:
        if any(share["policy"].values()):
            lines += ["", f"[{share['dataset']}]", "use_template = fellowship"]
            lines += [f"{period} = {kept}" for period, kept in share["policy"].items()]
    if backup_dataset:
        # Backups arrive with their snapshots, and only need old ones cleared
        lines += ["", f"[{backup_dataset}]", "use_template = fellowship",
                  "recursive = yes", "autosnap = no"]
        lines += [f"{period} = {kept}" for period, kept in BACKUP_POLICY.items()]
    return "\n".join(lines) + "\n"


def write_sanoid_config():
    shares = [s for s in list_shares() if not s["readonly"]]
    settings = read_json(BACKUP_FILE)
    target = None
    if settings and settings["target"] in writable_pools():
        target = backup_root(settings["target"])
    os.makedirs(os.path.dirname(SANOID_FILE), exist_ok=True)
    write_file(SANOID_FILE, sanoid_config(shares, target))


def list_snapshots(dataset):
    output = run("zfs", "list", "-Hp", "-t", "snapshot", "-o", "name,creation,used",
                 "-s", "creation", "-d", "1", dataset).stdout
    snapshots = []
    for line in output.splitlines():
        name, created, used = line.split("\t")
        snapshots.append({"name": name.split("@")[1], "created": int(created), "used": int(used)})
    return snapshots


def set_policy(name, hourly, daily, monthly):
    if hourly is None and daily is None and monthly is None:
        raise FnasError("nothing to change: pass --hourly, --daily or --monthly")
    share = find_share(name)
    policy = share["policy"]
    for period, kept in (("hourly", hourly), ("daily", daily), ("monthly", monthly)):
        if kept is not None:
            if not 0 <= kept <= MAX_KEPT:
                raise FnasError(f"--{period} must be between 0 and {MAX_KEPT}")
            policy[period] = kept
    value = ",".join(str(policy[period]) for period in DEFAULT_POLICY)
    run("zfs", "set", f"{POLICY_PROPERTY}={value}", share["dataset"])
    return policy


def set_backup(source, target):
    if source == target:
        raise FnasError("a backup needs a second pool, or losing one loses both")
    pools = writable_pools()
    for pool in (source, target):
        if pool not in pools:
            raise FnasError(f"no writable imported pool: {pool}")
    root = backup_root(target)
    if run("zfs", "list", "-H", "-o", "name", root, check=False).returncode != 0:
        # Never mounted, so nothing can change a backup or share it by accident
        run("zfs", "create", "-o", "mountpoint=none", root)
    write_json(BACKUP_FILE, {"source": source, "target": target, "since": int(time.time())})


def sync_backup(settings):
    """Copy the shares to the backup pool, returning what went wrong, if anything."""
    imported = [p["name"] for p in list_pools()]
    for pool in (settings["source"], settings["target"]):
        if pool not in imported:
            return f"pool {pool} isn't imported"
    target = f"{backup_root(settings['target'])}/{settings['source']}"
    run("zfs", "create", "-p", target)
    # Syncoid's own snapshot stays until the next run, so the backup pool can be
    # away for longer than Sanoid keeps anything. Properties go too, so a restored
    # share is still a share.
    result = run("syncoid", "--recursive", "--quiet", "--identifier=fellowship", "--sendoptions=p",
                 f"{settings['source']}/shares", f"{target}/shares", check=False)
    if result.returncode != 0:
        return (result.stderr or result.stdout).strip() or "syncoid failed"
    return None


def run_backup():
    settings = read_json(BACKUP_FILE)
    if not settings:
        raise FnasError("no backup job: run fnas backup set POOL TARGET")
    with locked(BACKUP_LOCK, wait=False):
        error = sync_backup(settings)
    state = read_json(BACKUP_STATE, {})
    state.update(last_attempt=int(time.time()), error=error)
    if not error:
        state["last_success"] = state["last_attempt"]
    write_json(BACKUP_STATE, state)
    run_checks()
    if error:
        raise FnasError(error)


def backup_status():
    settings = read_json(BACKUP_FILE)
    return {"job": settings, **read_json(BACKUP_STATE, {})} if settings else {"job": None}


def backup_target(pool):
    if pool:
        return pool
    settings = read_json(BACKUP_FILE)
    if not settings:
        raise FnasError("no backup job, so name the backup pool with --from")
    return settings["target"]


def list_backups(pool):
    root = backup_root(backup_target(pool))
    result = run("zfs", "list", "-H", "-o", "name", "-r", root, check=False)
    if result.returncode != 0:
        raise FnasError(f"no backups in {root}")
    backups = []
    for dataset in result.stdout.split():
        match = BACKUP_SHARE.match(dataset)
        if match:
            backups.append({"name": match.group(2), "pool": match.group(1), "dataset": dataset,
                            "snapshots": len(list_snapshots(dataset))})
    return backups


def restore_backup(name, from_pool, to_pool):
    backups = [b for b in list_backups(from_pool) if b["name"] == name]
    if not backups:
        raise FnasError(f"no backup of {name}")
    if len(backups) > 1:
        raise FnasError(f"{name} has backups from more than one pool")
    pool = to_pool or backups[0]["pool"]
    if pool not in writable_pools():
        raise FnasError(f"no writable imported pool: {pool}")
    if name.lower() in [s["name"].lower() for s in list_shares()]:
        raise FnasError(f"a share named {name} already exists, and a restore never replaces one")
    dataset = f"{pool}/shares/{name}"
    if run("zfs", "list", "-H", "-o", "name", dataset, check=False).returncode == 0:
        raise FnasError(f"{dataset} already exists and isn't a share")
    run("syncoid", "--quiet", "--no-sync-snap", "--sendoptions=p", backups[0]["dataset"], dataset)
    share = find_share(name)
    if share["nfs"]:
        # The backup holds the subnet from when it was made
        run("zfs", "set", f"sharenfs={sharenfs_value(share['mode'], lan_subnet())}", dataset)
    write_smb_config()


def alert_channels():
    settings = read_json(ALERTS_FILE, {})
    secrets = read_json(SECRETS_FILE, {})
    shown = {}
    if "email" in settings:
        email_settings = settings["email"]
        needs_password = bool(email_settings["user"]) and "smtp_password" not in secrets
        shown["email"] = {**email_settings, "needs_password": needs_password}
    if "ntfy" in settings:
        shown["ntfy"] = {**settings["ntfy"], "token": "ntfy_token" in secrets}
    return shown


def send_email(settings, severity, subject, body):
    mail = email.message.EmailMessage()
    mail["From"] = settings["from"]
    mail["To"] = settings["to"]
    mail["Subject"] = subject
    mail["Date"] = email.utils.formatdate(localtime=True)
    mail.set_content(body)
    result = run("msmtp", "-C", MSMTP_FILE, settings["to"], check=False, stdin=mail.as_string())
    if result.returncode != 0:
        raise FnasError(f"email: {result.stderr.strip() or 'msmtp failed'}")


def send_ntfy(settings, severity, subject, body):
    headers = {"Title": subject.encode("ascii", "replace").decode(),
               "Priority": NTFY_PRIORITY[severity]}
    token = read_json(SECRETS_FILE, {}).get("ntfy_token")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(settings["url"], data=body.encode(), headers=headers)
    try:
        urllib.request.urlopen(request, timeout=20).close()
    except (OSError, ValueError) as error:
        raise FnasError(f"ntfy: {error}") from None


def deliver(severity, title, body, channels=("email", "ntfy")):
    """Send to each channel in use, returning what couldn't be reached."""
    subject = f"[{socket.gethostname()}] {title}"
    settings = read_json(ALERTS_FILE, {})
    failures = []
    for channel, sender in (("email", send_email), ("ntfy", send_ntfy)):
        if channel in settings and channel in channels:
            try:
                sender(settings[channel], severity, subject, body)
            except FnasError as error:
                failures.append(str(error))
    return failures


def send_alert(severity, title, body):
    """Store an alert and send it, returning what couldn't be reached."""
    title = " ".join(title.split())
    failures = deliver(severity, title, body)
    with locked(ALERT_LOCK):
        alerts = read_json(ALERT_LOG, [])
        alerts.append({"time": int(time.time()), "severity": severity, "title": title,
                       "message": body, "undelivered": failures})
        write_json(ALERT_LOG, alerts[-MAX_ALERTS:])
    return failures


def retry_alerts(now):
    """Try again on the channels that failed. A disk can fail before the network is up."""
    retried = {}
    for alert in read_json(ALERT_LOG, []):
        if alert["undelivered"] and now - alert["time"] < RETRY_FOR:
            channels = [failure.split(":")[0] for failure in alert["undelivered"]]
            retried[alert["time"], alert["title"]] = deliver(
                alert["severity"], alert["title"], alert["message"], channels)
    if retried:
        with locked(ALERT_LOCK):
            alerts = read_json(ALERT_LOG, [])
            for alert in alerts:
                alert["undelivered"] = retried.get((alert["time"], alert["title"]), alert["undelivered"])
            write_json(ALERT_LOG, alerts)


def check_delivered(failures):
    if failures:
        raise FnasError("saved, but not delivered: " + "; ".join(failures))


def check_email(settings):
    if not MAIL_ADDRESS.match(settings["to"]) or not MAIL_ADDRESS.match(settings["from"]):
        raise FnasError("not an email address")
    if not MAIL_HOST.match(settings["host"]):
        raise FnasError(f"not a mail server name: {settings['host']}")
    if not 1 <= settings["port"] <= 65535:
        raise FnasError(f"not a port: {settings['port']}")
    if settings["tls"] not in ("starttls", "on", "off"):
        raise FnasError(f"not a TLS mode: {settings['tls']}")
    if settings["user"] and not MAIL_USER.match(settings["user"]):
        raise FnasError("mail user names can't contain spaces or quotes")


def check_ntfy(url):
    parts = urllib.parse.urlparse(url)
    if parts.scheme not in ("http", "https") or not parts.hostname or re.search(r"\s", url):
        raise FnasError(f"not a web address: {url}")


def msmtp_config(settings, password):
    lines = ["# Generated by fnas: changes here are overwritten",
             "account default", f"host {settings['host']}", f"port {settings['port']}",
             f"from {settings['from']}", "timeout 20",
             f"tls {'off' if settings['tls'] == 'off' else 'on'}",
             f"tls_starttls {'on' if settings['tls'] == 'starttls' else 'off'}",
             f"auth {'on' if settings['user'] else 'off'}"]
    if settings["user"]:
        lines.append(f"user {settings['user']}")
    if password:
        escaped = password.replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'password "{escaped}"')
    return "\n".join(lines) + "\n"


def set_secret(key, value):
    secrets = read_json(SECRETS_FILE, {})
    if value:
        secrets[key] = value
    else:
        secrets.pop(key, None)
    write_json(SECRETS_FILE, secrets, mode=0o600)


def set_alert_channel(channel, value):
    settings = read_json(ALERTS_FILE, {})
    if value:
        settings[channel] = value
    else:
        settings.pop(channel, None)
    write_json(ALERTS_FILE, settings)


def set_email(to, sender, host, port, user, tls, password):
    settings = {"to": to, "from": sender or to, "host": host, "port": port, "user": user, "tls": tls}
    check_email(settings)
    if password and "\n" in password:
        raise FnasError("mail passwords can't span lines")
    set_secret("smtp_password", password)
    set_alert_channel("email", settings)
    write_file(MSMTP_FILE, msmtp_config(settings, password), mode=0o600)


def set_ntfy(url, token):
    check_ntfy(url)
    set_secret("ntfy_token", token)
    set_alert_channel("ntfy", {"url": url})


def turn_off_email():
    set_secret("smtp_password", None)
    set_alert_channel("email", None)
    with contextlib.suppress(FileNotFoundError):
        os.remove(MSMTP_FILE)


def turn_off_ntfy():
    set_secret("ntfy_token", None)
    set_alert_channel("ntfy", None)


def finding(key, severity, title, body):
    return {"key": key, "severity": severity, "title": title, "message": body}


def pool_findings(pools):
    found = []
    for pool in pools:
        percent = pool["allocated"] * 100 // pool["size"]
        if percent >= FULL_WARNING:
            severity = "critical" if percent >= FULL_CRITICAL else "warning"
            found.append(finding(f"pool-full-{severity}-{pool['name']}", severity,
                                 f"Pool {pool['name']} is {percent}% full",
                                 "ZFS slows down as a pool fills. Free some space or add disks."))
    return found


def created_at(dataset):
    return int(run("zfs", "get", "-Hp", "-o", "value", "creation", dataset).stdout)


def last_scrub(pool):
    """When a scrub last finished, or when the pool was made if it never has."""
    match = SCRUB_DONE.search(run("zpool", "status", pool).stdout)
    if match:
        stamp = " ".join(match.group(1).split())
        return datetime.datetime.strptime(stamp, "%a %b %d %H:%M:%S %Y").timestamp()
    return created_at(pool)


def scrub_findings(pools, now):
    found = []
    for pool in pools:
        age = now - last_scrub(pool)
        if age > SCRUB_MAX_AGE:
            found.append(finding(f"scrub-old-{pool}", "warning", f"Pool {pool} hasn't been scrubbed",
                                 f"The last scrub was {age // DAY:.0f} days ago. "
                                 f"Start one with: sudo zpool scrub {pool}"))
    return found


def snapshot_findings(shares, now):
    found = []
    if run("systemctl", "is-failed", "--quiet", "sanoid.service", "sanoid-prune.service",
           check=False).returncode == 0:
        found.append(finding("sanoid-failed", "critical", "Snapshots failed",
                             "See what went wrong with: journalctl -u sanoid.service"))
    for share in shares:
        ages = [SNAPSHOT_MAX_AGE[period] for period, kept in share["policy"].items() if kept]
        if share["readonly"] or not ages:
            continue
        taken = [s["created"] for s in list_snapshots(share["dataset"])
                 if s["name"].startswith("autosnap_")]
        newest = max(taken) if taken else created_at(share["dataset"])
        if now - newest > min(ages):
            found.append(finding(f"snapshot-old-{share['name']}", "warning",
                                 f"Snapshots of {share['name']} have stopped",
                                 f"The newest is {(now - newest) / HOUR:.0f} hours old."))
    return found


def backup_findings(now):
    settings = read_json(BACKUP_FILE)
    if not settings:
        return []
    state = read_json(BACKUP_STATE, {})
    if state.get("error"):
        return [finding("backup-failed", "critical", "Backup failed", state["error"])]
    last = state.get("last_success", settings["since"])
    if now - last > BACKUP_MAX_AGE:
        return [finding("backup-overdue", "warning", "Backup overdue",
                        f"The last backup to {settings['target']} was "
                        f"{(now - last) / DAY:.0f} days ago.")]
    return []


def newest_kernel():
    kernels = os.listdir(MODULES_DIR)
    return max(kernels, key=lambda k: [int(n) for n in re.findall(r"\d+", k)], default=None)


def kernel_findings():
    kernel = newest_kernel()
    if kernel and not glob.glob(os.path.join(MODULES_DIR, kernel, "updates/dkms/zfs.ko*")):
        return [finding("zfs-module", "critical", f"No ZFS module for kernel {kernel}",
                        "Don't reboot into it: the pool wouldn't mount. "
                        "See /var/lib/dkms/zfs/*/build/make.log")]
    return []


def config_findings():
    return [finding(f"config-{pool}", "warning", f"Pool {pool} has settings from another install",
                    f"Settings aren't being saved to {pool}. Run fnas config restore {pool}, or "
                    f"fnas config adopt {pool} to replace them.") for pool in foreign_config_pools()]


def run_checks():
    """Send an alert for each new problem, a reminder each day, and a note when one clears."""
    after_change()
    now = time.time()
    pools = list_pools()
    writable = [p["name"] for p in pools if p["readonly"] == "off"]
    found = (pool_findings(pools) + scrub_findings(writable, now)
             + snapshot_findings(list_shares(), now) + backup_findings(now)
             + kernel_findings() + config_findings())
    previous = read_json(CHECK_STATE, {})
    current = {}
    for item in found:
        entry = previous.get(item["key"])
        if not entry or now - entry["sent"] >= REMIND_AFTER:
            send_alert(item["severity"], item["title"], item["message"])
            entry = {"sent": now, "title": item["title"]}
        current[item["key"]] = entry
    for key in previous.keys() - current.keys():
        send_alert("info", f"Resolved: {previous[key]['title']}", "This no longer needs attention.")
    write_json(CHECK_STATE, current)
    retry_alerts(now)
    return found


def install_id():
    """Tells this install's saved settings from those of an earlier one."""
    try:
        with open(INSTALL_ID_FILE) as file:
            return file.read().strip()
    except FileNotFoundError:
        value = str(uuid.uuid4())
        os.makedirs(os.path.dirname(INSTALL_ID_FILE), exist_ok=True)
        write_file(INSTALL_ID_FILE, value + "\n")
        return value


def config_path(pool):
    result = run("zfs", "get", "-H", "-o", "value", "mountpoint", f"{pool}/{CONFIG_DATASET}", check=False)
    path = result.stdout.strip()
    if result.returncode != 0 or not os.path.isdir(path):
        return None
    return os.path.join(path, "config.json")


def saved_config(pool):
    path = config_path(pool)
    return read_json(path) if path else None


def foreign_config_pools():
    pools = []
    for pool in writable_pools():
        saved = saved_config(pool)
        if saved and saved.get("install") != install_id():
            pools.append(pool)
    return pools


def local_users():
    groups = {group.gr_gid: group.gr_name for group in grp.getgrall()}
    return [{"name": user.pw_name, "uid": user.pw_uid, "gid": user.pw_gid,
             "group": groups.get(user.pw_gid), "comment": user.pw_gecos.split(",")[0]}
            for user in pwd.getpwall() if 1000 <= user.pw_uid < 60000]


def current_config():
    try:
        lan = lan_subnet()
    except FnasError:
        lan = None
    return {"version": CONFIG_VERSION, "install": install_id(), "saved": int(time.time()),
            "lan": lan, "backup": read_json(BACKUP_FILE), "alerts": read_json(ALERTS_FILE, {}),
            "shares": list_shares(), "users": local_users()}


def save_config(claim=()):
    """Copy settings to every pool, leaving alone any that a reinstall hasn't restored yet."""
    data = current_config()
    for pool in writable_pools():
        path = config_path(pool)
        if not path:
            continue
        saved = read_json(path)
        if not saved or saved.get("install") == data["install"] or pool in claim:
            write_json(path, data, mode=0o600)


def after_change():
    write_sanoid_config()
    save_config()


def restore_user(user):
    """Recreate one account, reporting anything that stops it matching the old one."""
    name, uid, gid, group = user["name"], user["uid"], user["gid"], user["group"]
    if not (ACCOUNT_NAME.match(name) and group and ACCOUNT_NAME.match(group)
            and 1000 <= uid < 60000 and 1000 <= gid < 60000):
        return f"skipped {name}: its saved details look wrong"
    try:
        existing = pwd.getpwnam(name)
        if existing.pw_uid != uid:
            return f"{name} already exists with UID {existing.pw_uid}, not {uid}: files won't match"
        return None
    except KeyError:
        pass
    try:
        return f"skipped {name}: UID {uid} already belongs to {pwd.getpwuid(uid).pw_name}"
    except KeyError:
        pass
    try:
        grp.getgrgid(gid)
    except KeyError:
        run("groupadd", "--gid", str(gid), group)
    comment = re.sub(r"[:\n]", " ", user.get("comment") or "")
    run("useradd", "--uid", str(uid), "--gid", str(gid), "--comment", comment,
        "--create-home", "--shell", "/bin/bash", name)
    return f"created {name}: set a password with sudo passwd {name}"


def restore_config(pool):
    """Bring back what a pool remembers. Passwords were never saved, so those are listed."""
    if pool not in writable_pools():
        raise FnasError(f"no writable imported pool: {pool}")
    saved = saved_config(pool)
    if not saved:
        raise FnasError(f"{pool} has no saved settings")
    if saved.get("version") != CONFIG_VERSION:
        raise FnasError(f"{pool} has settings from a different version of fnas")
    # Anyone can hand over a disk, so nothing on it is trusted
    alerts = saved.get("alerts", {})
    backup = saved.get("backup")
    if "email" in alerts:
        check_email(alerts["email"])
    if "ntfy" in alerts:
        check_ntfy(alerts["ntfy"]["url"])
    if backup:
        check_pool_name(backup["source"])
        check_pool_name(backup["target"])
    if saved.get("lan"):
        check_subnet(saved["lan"])

    notes = [note for note in map(restore_user, saved.get("users", [])) if note]
    if saved.get("lan"):
        set_lan(saved["lan"])
    if "email" in alerts:
        set_alert_channel("email", alerts["email"])
        write_file(MSMTP_FILE, msmtp_config(alerts["email"], None), mode=0o600)
        if alerts["email"]["user"]:
            notes.append("email alerts need their password again: fnas alert email-set")
    if "ntfy" in alerts:
        set_alert_channel("ntfy", alerts["ntfy"])
    if backup:
        write_json(BACKUP_FILE, {**backup, "since": int(time.time())})
    write_sanoid_config()
    # The old install saved to every pool, so take over all of its copies at once
    save_config(claim=[p for p in writable_pools()
                       if (saved_config(p) or {}).get("install") == saved.get("install")])
    return notes


def adopt_config(pool, confirm):
    expected = f"replace saved settings on {pool}"
    if confirm != expected:
        raise FnasError(f"this replaces the settings saved on {pool}\n"
                        f'confirm by passing --confirm "{expected}"')
    if pool not in writable_pools():
        raise FnasError(f"no writable imported pool: {pool}")
    save_config(claim=[pool])


def when(stamp):
    return datetime.datetime.fromtimestamp(stamp).strftime("%Y-%m-%d %H:%M")


def print_disks(disks, show_all):
    for disk in disks:
        if disk["state"] == "os" and not show_all:
            continue
        print(f"{disk['by_id'] or disk['path']}")
        print(f"    {human_size(disk['size'])}  {disk['model'] or 'unknown model'}  "
              f"serial {disk['serial'] or 'unknown'}")
        print(f"    {disk['state']}" + (f": {disk['reason']}" if disk["reason"] else ""))


def print_pools(pools):
    if not pools:
        print("No pools imported")
    for pool in pools:
        mode = "  read-only" if pool["readonly"] == "on" else ""
        print(f"{pool['name']}  {pool['health']}  {human_size(pool['allocated'])} used "
              f"of {human_size(pool['size'])}{mode}")


def print_scan(pools):
    if not pools:
        print("No importable pools found")
    for pool in pools:
        print(f"{pool.get('pool')}  id {pool.get('id')}  {pool.get('state')}")
        for key in ("status", "action"):
            if key in pool:
                print(f"    {key}: {pool[key]}")


def print_shares(shares):
    if not shares:
        print("No shares")
