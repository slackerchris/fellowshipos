BY_ID_DIR = "/dev/disk/by-id"
OS_MOUNTS = {"/", "/boot", "/boot/efi", "/usr", "/var"}
POOL_NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
RESERVED_POOL_PREFIXES = ("mirror", "raidz", "draid", "spare", "log", "cache")
POOL_PROPERTIES = ["ashift=12"]
DATASET_PROPERTIES = ["compression=lz4", "atime=off", "xattr=sa",
                      "acltype=posixacl", "dnodesize=auto"]
DEFAULT_DATASETS = ["shares", "home", "backups", "fellowship-config"]
LAYOUT_MIN_DISKS = {"single": 1, "mirror": 2, "raidz1": 3, "raidz2": 4}
# Stable names first: wwn and eui links exist alongside these on most disks
BY_ID_PREFERENCE = ("ata-", "nvme-", "scsi-", "virtio-", "usb-", "wwn-")

LAN_FILE = "/etc/fellowshipos/nas-lan"
SMB_DIR = "/etc/samba/fellowship"
SHARE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$")
SHARE_DATASET = re.compile(r"^([^/]+)/shares/([^/]+)$")
# Samba's own sections, which a share can't reuse
RESERVED_SHARE_NAMES = {"global", "homes", "printers", "print$"}
SHARE_MODES = ("shared", "matched")
MODE_PROPERTY = "org.fellowshipos:share-mode"
SMB_PROPERTY = "org.fellowshipos:smb"
# Fixed so that files on a moved pool keep their owner
SHARE_ACCOUNT = "nas-share"
SHARE_ID = 3000

HOUR = 3600
DAY = 24 * HOUR
SANOID_FILE = "/etc/sanoid/sanoid.conf"
POLICY_PROPERTY = "org.fellowshipos:snapshots"
DEFAULT_POLICY = {"hourly": 24, "daily": 30, "monthly": 6}
BACKUP_POLICY = {"hourly": 0, "daily": 30, "monthly": 12}
MAX_KEPT = 1000
SNAPSHOT_MAX_AGE = {"hourly": 3 * HOUR, "daily": 2 * DAY, "monthly": 33 * DAY}

STATE_DIR = "/var/lib/fellowship-nas"
BACKUP_FILE = "/etc/fellowshipos/nas-backup.json"
BACKUP_STATE = os.path.join(STATE_DIR, "backup.json")
BACKUP_LOCK = os.path.join(STATE_DIR, "backup.lock")
