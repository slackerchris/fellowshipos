<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Says "this is a FellowshipNAS" on the local network, so FellowshipOS's
     file manager (Strider) can list it first under Network. The port is
     the SMB shares'; admin-port is the web interface's. Samba's own
     _smb._tcp advert is unchanged. -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_fellowship-nas._tcp</type>
    <port>445</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>product=FellowshipNAS</txt-record>
    <txt-record>admin-port=443</txt-record>
  </service>
</service-group>
