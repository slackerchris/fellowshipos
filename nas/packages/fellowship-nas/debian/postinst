#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    [ ! -x /usr/sbin/update-grub ] || update-grub

    # Shared folders are owned by this account on every protocol. The ID is
    # fixed so files on a moved pool keep their owner.
    getent group nas-share > /dev/null || groupadd --system --gid 3000 nas-share
    getent passwd nas-share > /dev/null || useradd --system --uid 3000 --gid 3000 \
        --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin nas-share

    # Moves share settings an older fnas kept on ZFS properties into each
    # pool, exports shares through /etc/exports.d, and writes the NFS server's
    # settings (NFSv4 only unless changed), restarting it if they changed
    fnas share refresh || true

    # Lets only accounts set to Shares and SSH log in over SSH, and never root.
    # Every account with a login shell joins nas-ssh, so nobody is locked out
    fnas ssh refresh || true

    # Sends mdadm's array events, such as a failed disk, to alerts the moment
    # they happen, rather than at the next hourly check
    fnas pool watch-events || true

    # Debian's monthly array check, which Health records through fnas's drop-ins.
    # mdadm's preset turns it on; this makes sure, and says so when it can't
    if ! systemctl is-enabled --quiet mdcheck_start.timer 2> /dev/null; then
        systemctl enable mdcheck_start.timer mdcheck_continue.timer ||
            echo "fellowship-nas: couldn't turn on mdcheck_start.timer, so arrays won't be checked each month" >&2
    fi

    # Picks up the alert hook
    systemctl try-restart zfs-zed.service
    systemctl daemon-reload
    systemctl restart smartmontools.service || true
fi

#DEBHELPER#
