#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Not while an image is being built: there is no boot disk to probe yet,
    # and the installer writes GRUB's settings on the disk it installs to
    if [ -x /usr/sbin/update-grub ] && grub-probe / > /dev/null 2>&1; then
        update-grub
    fi

    # Shares for everyone are owned by this account on every protocol, and
    # people reach them in Files through its group. The ID is fixed so files on
    # a moved pool keep their owner. It was called nas-share; renaming keeps the
    # ID, so no file changes owner.
    if getent passwd nas-share > /dev/null && ! getent passwd file-share > /dev/null; then
        usermod --login file-share nas-share
    fi
    if getent group nas-share > /dev/null && ! getent group file-share > /dev/null; then
        groupmod --new-name file-share nas-share
    fi
    getent group file-share > /dev/null || groupadd --system --gid 3000 file-share
    getent passwd file-share > /dev/null || useradd --system --uid 3000 --gid 3000 \
        --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin file-share

    # Moves share settings an older fnas kept on ZFS properties into each
    # pool, puts every person not yet offered it in file-share, exports shares
    # through /etc/exports.d, and writes the NFS server's settings (NFSv4 only
    # unless changed), restarting it if they changed
    fnas share refresh || true

    # Lets only accounts set to Shares and SSH log in over SSH, and never root.
    # Every account with a login shell joins nas-ssh, so nobody is locked out
    fnas ssh refresh || true

    # Sends mdadm's array events, such as a failed disk, to alerts the moment
    # they happen, rather than at the next hourly check
    fnas pool watch-events || true

    # Storage checks run on the schedules in Settings: fnas's timer scrubs ZFS
    # pools in place of Debian's cron job, and Debian's mdcheck checks arrays
    # unless turned off. Says so when a timer can't be set
    fnas pool apply-schedules || true

    # Picks up the alert hook
    systemctl try-restart zfs-zed.service
    systemctl daemon-reload
    systemctl restart smartmontools.service || true
fi

#DEBHELPER#
