def over_time(now, count, step, value):
    """Sample points ending now, for the history the Health charts draw."""
    return [[now - (count - 1 - i) * step, *value(i)] for i in range(count)]


def disk(n, size, model, state="empty", reason="", temp=34, verdict="healthy", notes=(), bay=None):
    return {"path": f"/dev/sd{n}", "by_id": f"/dev/disk/by-id/ata-{model.replace(' ', '_')}_SN{n.upper()}0042",
            "size": size, "model": model, "serial": f"SN{n.upper()}0042", "state": state, "reason": reason,
            "kind": "disk", "bay": bay, "partitions": [],
            "temperature": temp, "hours": 18000, "verdict": verdict, "notes": list(notes)}


def member(d, state="ONLINE"):
    path = d["by_id"] + "-part1"
    return {"name": path, "type": "disk", "state": state, "path": path, "size": d["size"], "errors": 0, "note": ""}


def pool_status(state, name):
    """A RAIDZ2 group of the disks in the pool, as fnas pool status --json gives it."""
    used = [d for d in state["disks"] if d["reason"] == f"in pool {name}"]
    group = {"name": "raidz2-0", "type": "raidz2", "state": "ONLINE", "path": "", "size": 0, "errors": 0,
             "note": "", "disks": [member(d) for d in used]}
    running = [j for j in jobs(state) if j["pool"] == name and j["state"] == "running"]
    scan = {"function": "scrub", "state": "scanning", "progress": running[0]["progress"], "started": NOW,
            "ended": 0, "errors": 0} if running else None
    return {"name": name, "state": "ONLINE", "status": "", "action": "", "groups": [group], "spares": [],
            "scan": scan, "expand": None, "expandable": True}


def layouts(count, size):
    def option(layout, width, spares, survives, data, recommended=False):
        return {"layout": layout, "width": width, "groups": (count - spares) // width, "spares": spares,
                "usable": data * size, "unused": 0, "survives": survives, "recommended": recommended}
    if count == 1:
        return [option("single", 1, 0, 0, 1, True)]
    if count == 2:
        return [option("mirror", 2, 0, 1, 1, True)]
    found = [option("raidz2" if count >= 4 else "raidz1", count, 0, 2 if count >= 4 else 1,
                    count - (2 if count >= 4 else 1), True),
             option("raidz1", count, 0, 1, count - 1)]
    if count % 2 == 0:
        found.append(option("mirror", 2, 0, 1, count // 2))
    return found


def protocols(state):
    def entry(name, title, use, state_, detail):
        return {"name": name, "title": title, "for": use, "state": state_, "detail": detail,
                "shares": [s["name"] for s in state["shares"] if s.get(name)]}
    count = lambda name: len([s for s in state["shares"] if s.get(name)])
    return [entry("smb", "SMB", "Windows, Mac and phones", "running", f"Running, {count('smb')} shares"),
            entry("nfs", "NFS", "Linux computers, Proxmox and other servers", "running", f"Running, {count('nfs')} shares"),
            entry("sftp", "SFTP", "File transfer over SSH: scripts, FileZilla, phone apps", "not-built", "Not built yet (Phase 13)"),
            entry("ftp", "FTP", "Cameras, scanners and older devices", "not-built", "Not built yet (Phase 13)"),
            entry("webdav", "WebDAV", "A network drive over HTTPS, and phone apps", "not-built", "Not built yet (Phase 13)"),
            entry("dlna", "DLNA", "TVs and consoles finding media by themselves", "later", "Planned for after the storage engines"),
            entry("iscsi", "iSCSI", "Part of a pool as a disk on another machine", "later", "Planned for after the storage engines")]


def start_job(state, kind, title, pool):
    job = {"id": f"{len(state.setdefault('jobs', [])):012x}", "kind": kind, "title": title, "pool": pool,
           "state": "running", "progress": 0.0, "started": int(time.time()), "ended": None, "error": None}
    state["jobs"].insert(0, job)
    return f"{title}: follow it with fnas job show {job['id']}"


def jobs(state):
    """Jobs take a minute here, so their progress can be watched."""
    now = int(time.time())
    for job in state.get("jobs", []):
        if job["state"] == "running":
            job["progress"] = min((now - job["started"]) / 60, 1.0)
            if job["progress"] >= 1:
                job.update(state="done", ended=now)
    return state.get("jobs", [])


