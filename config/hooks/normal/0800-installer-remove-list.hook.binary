#!/bin/sh
set -e

# live-build lists everything added after its install pass, which includes
# packages from our chroot hooks such as Docker. Only remove the live system
# and the NAS installer, which is only for the live session.
printf '%s\n' live-boot live-boot-initramfs-tools live-config live-config-systemd user-setup \
    fellowship-installer cage cog \
    > live/filesystem.packages-remove
