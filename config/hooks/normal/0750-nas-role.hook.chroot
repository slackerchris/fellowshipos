#!/bin/bash
# The NAS image carries the NAS role already installed, with ZFS compiled for
# the image's kernel, so installing needs no network and nothing is built on the
# machine. Only the NAS image has the NAS packages (nas/packages/build.sh puts
# them in its own repo); the other images skip this.
#
# The live system the installer runs in must not act as a NAS: the web desktop
# would take port 80 from the installer, and ZFS would import the pools on the
# very disks someone is choosing between. So every unit the NAS packages turn
# on is turned off again here and listed in /etc/fellowshipos/nas-units, and
# the installed system's first start turns them on (nas-node.sh).
set -e

REPO=/usr/share/fellowshipos/nas-repo
[ -d "$REPO" ] || exit 0

enabled() {
    systemctl list-unit-files --state=enabled --no-legend | awk '{print $1}' | sort
}

before=$(mktemp)
after=$(mktemp)
enabled > "$before"

echo "deb [trusted=yes] file:$REPO ./" > /etc/apt/sources.list.d/fellowship-nas.list
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y fellowship-nas fellowship-nas-smb fellowship-nas-web

# zfs-dkms builds for every kernel whose headers are here; an image whose
# kernel has no module would only fail on the machine, so stop the build
for kernel in /lib/modules/*; do
    if ! modinfo -k "${kernel##*/}" zfs > /dev/null 2>&1; then
        echo "nas-role hook: no ZFS module for kernel ${kernel##*/}" >&2
        exit 1
    fi
done

enabled > "$after"
mkdir -p /etc/fellowshipos
comm -13 "$before" "$after" > "$after.new"
if [ -s "$after.new" ]; then
    xargs systemctl disable < "$after.new"
fi
# hd-idle stays off: fnas turns it on when a pool is given a spin-down time
grep -vx 'hd-idle.service' "$after.new" > /etc/fellowshipos/nas-units || true
echo "nas-role hook: units the installed system turns on:"
cat /etc/fellowshipos/nas-units
rm -f "$before" "$after" "$after.new"
