#!/bin/bash
# Desktop edition system defaults. Skipped on multi-purpose/server builds.
set -e

[ -x /usr/bin/fellowship-session ] || exit 0

# Networking, printing, Bluetooth, and graphical login services for desktop use.
systemctl enable NetworkManager.service 2>/dev/null || true
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-fellowship-managed.conf <<'EOF'
[ifupdown]
managed=true
EOF
systemctl enable cups.socket 2>/dev/null || true
systemctl enable bluetooth.service 2>/dev/null || true

# Graphical login greeter (greetd + Cage + fellowship-greeter) and restricted
# appearance persistence service.
if id -u _greetd >/dev/null 2>&1; then
    for grp in video render input; do
        if getent group "$grp" >/dev/null 2>&1; then
            usermod -aG "$grp" _greetd || true
        fi
    done
fi
install -d -m 0755 -o root -g root /var/lib/fellowship/greeter
# Ensure new users have ~/.local/share/keyrings present before their very first
# greetd login so gnome-keyring-daemon watches it immediately when pam_gnome_keyring
# creates and unlocks login.keyring on first boot.
install -d -m 0755 /etc/skel/.local /etc/skel/.local/share
install -d -m 0700 /etc/skel/.local/share/keyrings
systemctl enable greetd.service 2>/dev/null || true
systemctl enable fellowship-appearanced.service 2>/dev/null || true
# Adds the signed desktop update source on the installed system's first boot
systemctl enable fellowship-apt-source.service 2>/dev/null || true

# A desktop workstation should not expose an open SSH daemon by default;
# users who want remote access can enable ssh.service explicitly.
systemctl disable ssh.service ssh.socket 2>/dev/null || true

# Enable ufw with default-deny incoming at first boot without invoking
# iptables/nft inside the build container's chroot.
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    systemctl enable ufw.service 2>/dev/null || true
    # Except on a boot that asks for the installer page from another computer
    # (fellowship.installer.remote=ADDRESS): default-deny would refuse the
    # very connection that boot exists for. Measured on 0.4.2 RC1 in QEMU —
    # the page timed out with ufw running and answered with it masked.
    # Installed systems, live sessions and local installs keep the firewall.
    mkdir -p /etc/systemd/system/ufw.service.d
    cat > /etc/systemd/system/ufw.service.d/10-fellowship-remote-install.conf <<'EOF'
[Unit]
ConditionKernelCommandLine=!fellowship.installer.remote
EOF
fi
