[Unit]
Description=Add the FellowshipOS Desktop update source to apt
Documentation=file:///usr/share/doc/fellowship-desktop/
# Only on an installed system, and only once: a person who removes the source
# keeps it removed. The live image and the image build never trust the
# network source; they use what the ISO carries.
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/var/lib/fellowship/apt-source-added

[Service]
Type=oneshot
ExecStart=/usr/bin/install -Dm644 /usr/share/fellowshipos/fellowshipos.list /etc/apt/sources.list.d/fellowshipos.list
ExecStart=/usr/bin/install -d -m755 /var/lib/fellowship
ExecStart=/usr/bin/touch /var/lib/fellowship/apt-source-added

[Install]
WantedBy=multi-user.target
