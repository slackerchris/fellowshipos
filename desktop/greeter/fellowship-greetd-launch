#!/bin/sh
# Select live vs installed greetd configuration at boot.
# Installed systems always land on fellowship-greeter; live ISO boots
# ("Try FellowshipOS") enter the live desktop once and return to the greeter
# on logout. Graphical installer boots skip greetd via systemd condition.
set -eu

if grep -qw 'boot=live' /proc/cmdline 2>/dev/null; then
    exec /usr/sbin/greetd --config /etc/fellowship/greetd-live.toml
fi
exec /usr/sbin/greetd --config /etc/fellowship/greetd.toml
