#!/bin/bash
# Start the FellowshipOS Wayland desktop session.
#
#   fellowship-session [fellowship-comp arguments...]
#
# Launched by greetd after PAM authentication on tty1 (or directly for
# debugging). Starts the compositor on the seat through DRM with the user's
# systemd D-Bus session bus, PipeWire audio, and Secret Service keyring, and
# cleans up session-scoped graphical environment on logout without disturbing
# unrelated SSH/TTY sessions or the user's systemd manager.
set -e

# One graphical session per user seat: never let two compositors fight over DRM.
LOCK=${FELLOWSHIP_SESSION_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/fellowship-session.lock}
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "a FellowshipOS session is already running (lock: $LOCK)"
    exit 0
fi

# Keep the session log inside the user's own state directory (never /tmp).
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fellowship"
if [ -n "${FELLOWSHIP_SESSION_LOG:-}" ]; then
    LOG="$FELLOWSHIP_SESSION_LOG"
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
elif mkdir -p "$STATE_DIR" 2>/dev/null; then
    LOG="$STATE_DIR/session.log"
else
    LOG="${XDG_RUNTIME_DIR:-$HOME}/fellowship-session.log"
fi
exec >>"$LOG" 2>&1
echo "--- $(date -Is) fellowship-session on $(tty 2>/dev/null || echo non-tty) as $(id -un)"

export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Fellowship}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-fellowship}"
export XCURSOR_THEME="${XCURSOR_THEME:-breeze_cursors}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Sound: PipeWire, its Pulse-compatible socket, and WirePlumber via user systemd.
if systemctl --user enable --now pipewire.socket pipewire.service \
                  pipewire-pulse.service wireplumber.service 2>/dev/null; then
    :
else
    for daemon in pipewire pipewire-pulse wireplumber; do
        if command -v "$daemon" >/dev/null 2>&1 &&
           ! pgrep -u "$(id -u)" -x "$daemon" >/dev/null 2>&1; then
            "$daemon" >/dev/null 2>&1 &
        fi
    done
fi

# Create standard XDG user directories (Desktop, Downloads, Pictures, ...).
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update

# Share the systemd user session bus when available so PipeWire, portals,
# GVfs, keyring, and desktop apps all speak on the same bus.
USER_BUS="/run/user/$(id -u)/bus"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$USER_BUS" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_BUS"
fi

# Initialize the Secret Service daemon (unlocked by pam_gnome_keyring during
# greetd login) and export its environment to the user session.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v gnome-keyring-daemon >/dev/null 2>&1; then
    systemctl --user import-environment DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
    eval "$(gnome-keyring-daemon --start --components=secrets,pkcs11 2>/dev/null)" || true
    export SSH_AUTH_SOCK GNOME_KEYRING_CONTROL
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus StartServiceByName su org.freedesktop.secrets 0 >/dev/null 2>&1 || true
fi

COMP_PID=""
cleanup_session() {
    # Clear graphical display variables from the user manager so a subsequent
    # login starts with fresh sockets; do not kill the user manager itself or
    # any unrelated SSH/background sessions.
    systemctl --user unset-environment WAYLAND_DISPLAY FELLOWSHIP_CONTROL 2>/dev/null || true
    echo "--- $(date -Is) fellowship-session ended"
}
forward_signal() {
    if [ -n "$COMP_PID" ]; then
        kill -TERM "$COMP_PID" 2>/dev/null || true
    fi
}
trap cleanup_session EXIT
trap forward_signal TERM INT HUP

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    fellowship-comp --backend drm --mod super "$@" &
else
    dbus-run-session -- fellowship-comp --backend drm --mod super "$@" &
fi
COMP_PID=$!
set +e
wait "$COMP_PID"
STATUS=$?
exit "$STATUS"
